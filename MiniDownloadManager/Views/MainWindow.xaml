<Window
    Background="#080C17"
    Height="500"
    MinHeight="400"
    MinWidth="800"
    Title="Mini Download Manager"
    Width="850"
    mc:Ignorable="d"
    x:Class="MiniDownloadManager.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MiniDownloadManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:MiniDownloadManager.Views"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.Resources>
        <!--  Embedded mock data for preview  -->
        <XmlDataProvider XPath="/Downloads/Download" x:Key="MockDownloads">
            <x:XData>
                <Downloads xmlns="">
                    <Download
                        Actions="Pause"
                        Name="ubuntu-26.04-desktop.iso"
                        Progress="45%"
                        Size="2.4 GB"
                        Speed="12.5 MB/s"
                        Status="Downloading" />
                    <Download
                        Actions="Resume"
                        Name="Project_Backup.zip"
                        Progress="80%"
                        Size="450 MB"
                        Speed="0 MB/s"
                        Status="Paused" />
                    <Download
                        Actions="Open"
                        Name="VSCodeUserSetup.exe"
                        Progress="100%"
                        Size="95 MB"
                        Speed="Finished"
                        Status="Completed" />
                    <Download
                        Actions="Start"
                        Name="Game_Installer.dmg"
                        Progress="0%"
                        Size="42 GB"
                        Speed="Waiting"
                        Status="Queued" />
                    <Download
                        Actions="Pause"
                        Name="Design_Draft.psd"
                        Progress="30%"
                        Size="1.1 GB"
                        Speed="5.2 MB/s"
                        Status="Downloading" />
                </Downloads>
            </x:XData>
        </XmlDataProvider>

        <!--  Override DataGridCell to kill default blue selection + focus borders  -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#312E81" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Semantic status colors for the "Status" column  -->
        <Style TargetType="TextBlock" x:Key="StatusTextStyle">
            <Style.Triggers>
                <DataTrigger Binding="{Binding XPath=@Status}" Value="Downloading">
                    <Setter Property="Foreground" Value="#A78BFA" />
                    <!--  light violet  -->
                </DataTrigger>
                <DataTrigger Binding="{Binding XPath=@Status}" Value="Paused">
                    <Setter Property="Foreground" Value="#FCD34D" />
                    <!--  muted amber  -->
                </DataTrigger>
                <DataTrigger Binding="{Binding XPath=@Status}" Value="Completed">
                    <Setter Property="Foreground" Value="#34D399" />
                    <!--  emerald green  -->
                </DataTrigger>
                <DataTrigger Binding="{Binding XPath=@Status}" Value="Queued">
                    <Setter Property="Foreground" Value="#94A3B8" />
                    <!--  soft gray-blue  -->
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Interactive actions link style  -->
        <Style TargetType="TextBlock" x:Key="ActionLinkStyle">
            <Setter Property="Foreground" Value="#A78BFA" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>


    </Window.Resources>

    <!--  Root layout: no margin, full window stretch  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Top navigation toolbar: full-width, darker background, inner padding  -->
        <Border
            Background="#0D1120"
            Grid.Row="0"
            Padding="12,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>

                <Button
                    Click="NewDownloadView_DownloadRequested"
                    Content="+ Add Download"
                    Cursor="Hand"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Grid.Column="0"
                    Padding="18,10">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="#7B61FF"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Grid Grid.Column="2">
                    <Border
                        Background="#13182B"
                        BorderBrush="#29304A"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="4,2">
                        <TextBox
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="#7B61FF"
                            Foreground="#DCE2F0"
                            Padding="8,4"
                            VerticalContentAlignment="Center"
                            x:Name="SearchInput" />
                    </Border>

                    <TextBlock
                        FontSize="12"
                        Foreground="#6B7B9C"
                        HorizontalAlignment="Left"
                        IsHitTestVisible="False"
                        Margin="14,0,0,0"
                        Text="Search in downloads..."
                        VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=SearchInput, Path=Text}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!--  DataGrid with fixed selection, status colors, and action links  -->
        <DataGrid
            AutoGenerateColumns="False"
            Background="#13182B"
            BorderBrush="#29304A"
            BorderThickness="1"
            CanUserResizeColumns="False"
            Foreground="#DCE2F0"
            Grid.Row="1"
            GridLinesVisibility="Horizontal"
            HeadersVisibility="Column"
            HorizontalGridLinesBrush="#29304A"
            IsReadOnly="True"
            ItemsSource="{Binding Source={StaticResource MockDownloads}, XPath=/Downloads/Download}"
            Margin="0,8,0,0"
            RowBackground="#13182B"
            RowHeight="38"
            SelectionChanged="DownloadsDataGrid_SelectionChanged">

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#DCE2F0" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#312E81" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#0D1120" />
                    <Setter Property="Foreground" Value="#8E9AB8" />
                    <Setter Property="Padding" Value="12,10" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding XPath=@Name}"
                    Header="Name"
                    Width="*" />
                <DataGridTextColumn
                    Binding="{Binding XPath=@Progress}"
                    Header="Progress"
                    Width="120" />
                <DataGridTextColumn
                    Binding="{Binding XPath=@Speed}"
                    Header="Speed"
                    Width="100" />
                <DataGridTextColumn
                    Binding="{Binding XPath=@Status}"
                    ElementStyle="{StaticResource StatusTextStyle}"
                    Header="Status"
                    Width="110" />
                <DataGridTextColumn
                    Binding="{Binding XPath=@Size}"
                    Header="Size"
                    Width="90" />
                <DataGridTextColumn
                    Binding="{Binding XPath=@Actions}"
                    ElementStyle="{StaticResource ActionLinkStyle}"
                    Header="Actions"
                    Width="100" />
            </DataGrid.Columns>
        </DataGrid>
        <Border
            Background="#0D1120"
            BorderBrush="#29304A"
            BorderThickness="1,0,0,0"
            Grid.Row="2"
            Height="220"
            VerticalAlignment="Bottom"
            Visibility="Collapsed"
            x:Name="DetailsPanelOverlay">
            <views:DownloadDetailsView x:Name="DownloadDetailsViewControl" />
        </Border>

        <Grid
            Background="#A0080C17"
            Grid.RowSpan="3"
            Panel.ZIndex="100"
            Visibility="Collapsed"
            x:Name="NewDownloadOverlay">

            <ContentControl
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                x:Name="DialogHost" />
        </Grid>

    </Grid>
</Window>